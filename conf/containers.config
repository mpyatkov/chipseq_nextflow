/*
 * Singularity containers for every process (replaces `module load` / `conda activate`).
 *
 *   rlang_sif / tools_sif : images built from containers/rlang and containers/chipseq_tools
 *   containers.*          : Biocontainers pulled by Nextflow into singularity.cacheDir.
 *                           picard, multiqc, subread and deeptools use the same tags as
 *                           the RNA-seq pipeline, so the shared cache already has them.
 *
 * Use in a process:   container params.rlang_sif
 *                     container params.containers.multiqc
 */

params {
    rlang_sif = '/projectnb/wax-es/routines/singularity/chipseq/rlang.sif'
    tools_sif = '/projectnb/wax-es/routines/singularity/chipseq/chipseq_tools.sif'

    containers = [
        trimgalore : 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_1',  // includes cutadapt + fastqc
        fastqc     : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
        multiqc    : 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1',       // cached (rnaseq)
        picard     : 'quay.io/biocontainers/picard:3.5.0--hdfd78af_0',         // cached (rnaseq), includes R
        subread    : 'quay.io/biocontainers/subread:2.1.1--h577a1d6_0',        // cached (rnaseq), featureCounts
        deeptools  : 'quay.io/biocontainers/deeptools:3.5.6--pyhdfd78af_0',    // cached (rnaseq), bigwigAverage
        poppler    : 'quay.io/biocontainers/poppler:25.07.0',                  // pdfunite
    ]
}

singularity {
    enabled    = true
    autoMounts = true
    // Shared with the RNA-seq pipeline: images are named by their full URI, so no clashes.
    cacheDir   = '/projectnb/wax-es/routines/singularity/nf_cache'
    // /projectnb : bowtie2 index and other paths passed to tools as plain strings
    // $TMPDIR    : node-local scratch used by `scratch = true`
    runOptions = '-B /projectnb -B "$TMPDIR"'
}
