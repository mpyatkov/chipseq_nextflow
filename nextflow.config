process {
    executor = 'sge'  
    scratch = true
    penv = 'smp'
    clusterOptions="-P wax-es"
}


process {
    withName: 'retrieve_cached_bams' {
        stageInMode = 'symlink'
        scratch = false
    }
}

params {
    genomes {
        mm9 {
            chrom_sizes          = "${projectDir}/assets/mm9/mm9.chrom.sizes"
            blacklist_complement = "${projectDir}/assets/mm9/mm9-blacklist_complement"
            sex_marker_genes     = "${projectDir}/assets/mm9/sex_marker_genes.saf"
            default_tracks       = "${projectDir}/assets/mm9/default_tracks.txt"
            bowtie2_index        = "/projectnb/wax-es/aramp10/Bowtie2/Bowtie2Index/genome"
            bam_cache            = "/projectnb/wax-es/CHIPSEQ_BAM_CACHE"        // existing cache, unchanged
            diffreps_gname       = "mm9"
            ucsc_db              = "mm9"
        }
        mm10 {
            chrom_sizes          = "${projectDir}/assets/mm10/mm10.chrom.sizes"
            blacklist_complement = "${projectDir}/assets/mm10/mm10-blacklist_complement"
            sex_marker_genes     = "${projectDir}/assets/mm10/sex_marker_genes.saf"
            default_tracks       = "${projectDir}/assets/mm10/default_tracks.txt"
            bowtie2_index        = "/projectnb/wax-es/routines/bowtie2index/mm10_chr/mm10"
            bam_cache            = "/projectnb/wax-es/CHIPSEQ_BAM_CACHE_MM10"
            diffreps_gname       = "mm10"
            ucsc_db              = "mm10"
        }
    }
}